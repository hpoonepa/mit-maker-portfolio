{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/immunebuilder/input.json",
  "title": "ImmuneBuilder Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "receptorType": {
          "type": "string",
          "enum": ["antibody", "nanobody", "tcr"]
        },
        "sequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "oneOf": [
              { "type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$" },
              {
                "type": "object",
                "required": ["sequence"],
                "properties": {
                  "id": { "type": "string" },
                  "sequence": {
                    "type": "string",
                    "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": true
    }
  }
}
