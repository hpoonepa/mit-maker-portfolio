{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/antifold/output.json",
  "title": "AntiFold Result",
  "type": "object",
  "required": ["designs", "runMetadata"],
  "properties": {
    "designs": { "type": "array", "items": { "type": "object", "required": ["structurePath", "sequence", "metrics", "seed"], "properties": { "structurePath": { "type": "string" }, "sequence": { "type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$" }, "metrics": { "type": "object", "additionalProperties": { "type": "number" } }, "seed": { "type": "integer" } }, "additionalProperties": false } },
    "runMetadata": { "type": "object", "properties": { "tool": { "const": "antifold" } }, "required": ["tool"], "additionalProperties": true }
  },
  "additionalProperties": false
}
