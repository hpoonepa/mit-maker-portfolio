{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/prodigy/input.json",
  "title": "PRODIGY Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "targetPdb": { "type": "string" },
        "targetPdbText": { "type": "string" },
        "targetPdbUrl": { "type": "string", "format": "uri" },
        "selection": {
          "description": "Disjoint chain groups, for example [\"A,B\", \"C\"].",
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "temperature": { "type": "number", "minimum": 0, "maximum": 100 },
        "distanceCutoff": { "type": "number", "minimum": 3, "maximum": 10 },
        "accessibilityThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    }
  }
}
