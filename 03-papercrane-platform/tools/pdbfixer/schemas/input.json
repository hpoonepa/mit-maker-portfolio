{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/pdbfixer/input.json",
  "title": "PDBFixer Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "params": { "type": "object", "properties": { "targetPdb": { "type": "string" }, "addMissingResidues": { "type": "boolean" }, "replaceNonstandardResidues": { "type": "boolean" }, "removeHeterogens": { "type": "boolean" }, "keepWater": { "type": "boolean" }, "addHydrogens": { "type": "boolean" }, "ph": { "type": "number", "minimum": 0, "maximum": 14 } }, "additionalProperties": true }
  }
}
