{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/prody/output.json",
  "title": "ProDy Result",
  "type": "object",
  "required": ["designs", "runMetadata"],
  "properties": {
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["structurePath", "metrics", "seed"],
        "properties": {
          "structurePath": { "type": "string" },
          "sequence": { "type": "string" },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "seed": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "runMetadata": {
      "type": "object",
      "required": ["tool"],
      "properties": { "tool": { "const": "prody" } },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
