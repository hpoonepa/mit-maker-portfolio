{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/cd-hit/input.json",
  "title": "CD-HIT Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "sequences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10000,
          "items": { "$ref": "#/definitions/sequenceRecord" }
        },
        "identity": { "type": "number", "minimum": 0.4, "maximum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "sequenceRecord": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 6,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
        },
        {
          "type": "object",
          "required": ["sequence"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sequence": {
              "type": "string",
              "minLength": 6,
              "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
            }
          }
        }
      ]
    }
  }
}
