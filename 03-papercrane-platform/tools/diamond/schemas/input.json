{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/diamond/input.json",
  "title": "DIAMOND Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "querySequence": {
          "type": "string",
          "minLength": 6,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
        },
        "referenceSequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/definitions/sequenceRecord" }
        },
        "sequences": {
          "description": "Convenience form: the first sequence is the query and the rest are references.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10001,
          "items": { "$ref": "#/definitions/sequenceRecord" }
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "fast",
            "mid-sensitive",
            "sensitive",
            "more-sensitive",
            "very-sensitive",
            "ultra-sensitive"
          ]
        },
        "evalue": { "type": "number", "exclusiveMinimum": 0 },
        "maxHits": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "sequenceRecord": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 6,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
        },
        {
          "type": "object",
          "required": ["sequence"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sequence": {
              "type": "string",
              "minLength": 6,
              "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
            }
          }
        }
      ]
    }
  }
}
