{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/protparam/input.json",
  "title": "ProtParam Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
        },
        "sequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/sequenceRecord" }
        },
        "pH": { "type": "number", "minimum": 0, "maximum": 14 }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "sequenceRecord": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
        },
        {
          "type": "object",
          "required": ["sequence"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sequence": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
            }
          }
        }
      ]
    }
  }
}
