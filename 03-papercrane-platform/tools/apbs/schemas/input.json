{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/apbs/input.json",
  "title": "APBS Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "targetPdb": { "type": "string" },
        "targetPdbText": { "type": "string" },
        "forceField": { "enum": ["AMBER", "CHARMM", "PARSE"] },
        "ph": { "type": "number", "minimum": 0, "maximum": 14 },
        "equation": { "enum": ["lpbe", "npbe"] },
        "soluteDielectric": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "solventDielectric": {
          "type": "number",
          "minimum": 20,
          "maximum": 120
        },
        "ionicStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "temperature": {
          "type": "number",
          "minimum": 250,
          "maximum": 400
        },
        "probeRadius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5
        },
        "gridPoints": { "enum": [33, 65, 97, 129] }
      },
      "additionalProperties": true
    }
  }
}
