{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/omegafold/input.json",
  "title": "OmegaFold Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "sequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$" },
              {
                "type": "object",
                "required": ["sequence"],
                "properties": {
                  "id": { "type": "string" },
                  "sequence": {
                    "type": "string",
                    "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
        },
        "model": { "type": "integer", "enum": [1, 2] },
        "numCycle": { "type": "integer", "minimum": 1, "maximum": 20 },
        "subbatchSize": { "type": "integer", "minimum": 16, "maximum": 1024 }
      },
      "additionalProperties": true
    }
  }
}
