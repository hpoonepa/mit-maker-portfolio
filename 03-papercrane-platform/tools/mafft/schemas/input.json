{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/mafft/input.json",
  "title": "MAFFT Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "sequences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
              },
              {
                "type": "object",
                "required": ["sequence"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sequence": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
                  }
                }
              }
            ]
          }
        },
        "strategy": {
          "type": "string",
          "enum": ["auto", "linsi", "ginsi", "einsi", "fftns2"]
        },
        "reorder": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
