{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/mafft/output.json",
  "title": "MAFFT Result",
  "type": "object",
  "required": ["designs", "runMetadata"],
  "additionalProperties": false,
  "properties": {
    "designs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["structurePath", "metrics", "seed"],
        "additionalProperties": false,
        "properties": {
          "structurePath": { "type": "string" },
          "sequence": { "type": "string" },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "seed": { "type": "integer" }
        }
      }
    },
    "runMetadata": {
      "type": "object",
      "required": ["tool"],
      "additionalProperties": true,
      "properties": { "tool": { "const": "mafft" } }
    }
  }
}
