{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/rfd3/input.json",
  "title": "RFdiffusion3 Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "params": {
      "type": "object",
      "properties": {
        "targetPdb": { "type": "string" },
        "targetChain": { "type": "string", "minLength": 1, "maxLength": 4 },
        "binderLengthMin": { "type": "integer", "minimum": 20, "maximum": 500 },
        "binderLengthMax": { "type": "integer", "minimum": 20, "maximum": 500 },
        "contig": { "type": "string" },
        "hotspots": { "type": "array" },
        "numTimesteps": { "type": "integer", "minimum": 20, "maximum": 500 },
        "isNonLoopy": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
