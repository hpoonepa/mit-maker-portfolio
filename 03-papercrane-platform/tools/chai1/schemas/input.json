{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/chai1/input.json",
  "title": "Chai-1 Input Parameters",
  "description": "Chai-1 structure prediction input. Primary input is a multi-chain FASTA.",
  "type": "object",
  "additionalProperties": false,
  "required": ["chains"],
  "properties": {
    "chains": {
      "description": "List of protein chains to co-fold (e.g. target + binder). Order is preserved; chain ids must be unique.",
      "type": "array",
      "minItems": 1,
      "maxItems": 26,
      "items": {
        "type": "object",
        "required": ["id", "sequence"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Single-letter chain id (A..Z).",
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "sequence": {
            "description": "Protein sequence in 1-letter amino-acid codes.",
            "type": "string",
            "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "params": {
      "description": "Chai-1-specific knobs. Overrides defaultParams in manifest.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "num_trunk_recycles": {
          "description": "Number of trunk recycles (Chai-1 default 3).",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "num_diffn_timesteps": {
          "description": "Number of diffusion timesteps (Chai-1 default 200).",
          "type": "integer",
          "minimum": 10,
          "maximum": 500
        },
        "use_esm_embeddings": {
          "description": "Whether to use ESM embeddings (speeds up when MSAs unavailable).",
          "type": "boolean"
        }
      }
    },
    "seeds": {
      "description": "Integer seeds; one prediction is emitted per seed.",
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 1,
      "maxItems": 32
    },
    "binderChainId": {
      "description": "Chain id that should be treated as the designed binder for binder-specific metrics (plddt_binder).",
      "type": "string",
      "pattern": "^[A-Z]$"
    }
  }
}
