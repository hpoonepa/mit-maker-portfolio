{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/foldseek/input.json",
  "title": "Foldseek Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "targetPdb": { "type": "string" },
        "partnerPdb": { "type": "string" },
        "targetPdbText": { "type": "string" },
        "partnerPdbText": { "type": "string" },
        "alignmentType": { "type": "integer", "enum": [0, 1, 2] }
      },
      "additionalProperties": true
    }
  }
}
