{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://papercrane.dev/schemas/hhsuite/input.json",
  "title": "HH-suite Input",
  "type": "object",
  "required": ["seeds", "params"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "params": {
      "type": "object",
      "properties": {
        "querySequence": {
          "type": "string",
          "minLength": 6,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
        },
        "referenceSequence": {
          "type": "string",
          "minLength": 6,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
        },
        "queryAlignment": {
          "description": "A3M-formatted query alignment.",
          "type": "string",
          "minLength": 8
        },
        "referenceAlignment": {
          "description": "A3M-formatted reference alignment.",
          "type": "string",
          "minLength": 8
        },
        "sequences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/definitions/sequenceRecord" }
        },
        "alignmentMode": { "type": "string", "enum": ["local", "global"] },
        "mact": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "sequenceRecord": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 6,
          "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
        },
        {
          "type": "object",
          "required": ["sequence"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sequence": {
              "type": "string",
              "minLength": 6,
              "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZJUO]+$"
            }
          }
        }
      ]
    }
  }
}
