# Paper Crane — Environment Variables
# Copy this file to `.env.local` and fill in values:
#   cp .env.example .env.local
# Never commit .env.local or any file with real secrets.
# See docs/env-vars.md for the full reference.
#
# Legend:
#   [REQUIRED]  must be set or the app will refuse to start
#   [DEV-OPT]   optional in local dev — leave empty, system uses safe stubs
#   [PROD-ONLY] only needed when deploying

# === Core ===
# Runtime environment. One of: development | test | staging | production.
NODE_ENV=development
# Logging verbosity. One of: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
# Set identically in app (build/runtime) and API (runtime) after admission migrations.
# true requires a beta invite; false leaves public registration enabled.
NEXT_PUBLIC_BETA_GATE=false
# [DEV-OPT] When true, the worker uses the in-process Modal stub instead of
# hitting real compute. Vast/RunPod are reserved and are not providers yet.
WORKER_DEV_MODE=true

# === Supabase (Auth + Postgres) — REQUIRED ===
# [REQUIRED] Public project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# [REQUIRED] Public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [REQUIRED] Server-only key with elevated privileges. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=<paste-from-supabase-dashboard>
# [DEV-OPT] Project ref slug (the <project-ref> segment of the Supabase URL).
SUPABASE_PROJECT_REF=

# === Database (Postgres via Prisma) — REQUIRED ===
# [REQUIRED] Pooled connection used by the app at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/papercrane
# [REQUIRED] Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/papercrane

# === Redis (Upstash) ===
# [DEV-OPT] Upstash Redis connection string (rediss:// for TLS).
# Leave empty in dev — the queue falls back to an in-memory stub.
REDIS_URL=

# === Object Storage (Cloudflare R2) ===
# [DEV-OPT] R2 account ID from the Cloudflare dashboard.
R2_ACCOUNT_ID=
# [DEV-OPT] R2 access key ID (created under R2 > Manage API Tokens).
R2_ACCESS_KEY_ID=
# [DEV-OPT] R2 secret access key (paired with the access key ID above).
R2_SECRET_ACCESS_KEY=
# [DEV-OPT] R2 bucket name. Use `papercrane-dev` locally, `papercrane-prod` in prod.
R2_BUCKET=papercrane-dev

# === Stripe ===
# [DEV-OPT] Secret key (sk_test_... in dev, sk_live_... in prod).
# When empty, billing routes return a stub "billing disabled" response.
STRIPE_SECRET_KEY=
# [DEV-OPT] Webhook signing secret (whsec_...). Required only if testing webhooks.
STRIPE_WEBHOOK_SECRET=
# [DEV-OPT] Recurring price IDs (price_...). Only needed for billing flows.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SEAT_ADDON=
STRIPE_PRICE_PACK_10K=

# === GPU Providers ===
# [DEV-OPT] Modal authentication token pair (modal token new).
# Leave empty in dev — WORKER_DEV_MODE=true short-circuits real submissions.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# [REQUIRED in prod] 32-byte key used to encrypt linked organization Modal
# token secrets at rest. Generate with: openssl rand -base64 32
MODAL_CREDENTIAL_ENCRYPTION_KEY=
# [DEV-OPT] Workspace label for logs only. Modal credentials select the actual
# workspace; this value does not switch accounts.
MODAL_WORKSPACE=papercrane-dev
# [DEV-OPT] Modal environment. Leave empty to use the workspace default.
MODAL_ENVIRONMENT=
# [DEV-OPT] Per-job seed fan-out (1-8). Defaults to 2 for GPU, 4 for CPU.
MODAL_SEED_PARALLELISM=
# [DEV-OPT] Deploy a missing named app on its first invocation. Disable only
# when deployments are managed separately with `pnpm modal:deploy:core`.
PAPERCRANE_MODAL_AUTO_DEPLOY=1
# [RESERVED] Vast.ai provider is not implemented yet.
VASTAI_API_KEY=
# [RESERVED] RunPod provider is not implemented yet.
RUNPOD_API_KEY=

# === Email (Resend) ===
# [DEV-OPT] Resend API key. When empty, transactional emails are logged
# to stdout instead of being sent.
RESEND_API_KEY=

# === Observability ===
# [DEV-OPT] Sentry project DSN. Leave empty in dev.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# [DEV-OPT] PostHog project API key (ph_...).
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# [DEV-OPT] BetterStack (Logtail) source token for structured log shipping.
LOGTAIL_SOURCE_TOKEN=

# === Infisical (secrets bootstrap) ===
# [PROD-ONLY] Machine identity used to pull production secrets at boot.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=

# === App URLs ===
# Public web app URL (used for OAuth redirects, emails, share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Internal API base URL (called by web + worker).
API_BASE_URL=http://localhost:3001
# Worker service URL (job status, callbacks).
WORKER_URL=http://localhost:3002

# === Feature Flags ===
FEATURE_FRONTIER_TIER=false
FEATURE_PUBLIC_LEADERBOARD=true

# === Security ===
# [REQUIRED in prod] 32-byte random hex used to pepper API key hashes.
# Generate with: openssl rand -hex 32
API_KEY_PEPPER=change-me-to-32-random-bytes
