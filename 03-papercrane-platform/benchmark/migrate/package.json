{
  "name": "@papercrane/benchmark-migrate",
  "version": "0.1.0",
  "private": true,
  "description": "Paper Crane benchmark data migration CLI — ports historical campaign results (God V3B, 5G51 V4, RBX1) into the normalized Postgres schema that feeds the public leaderboard.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "papercrane-migrate": "dist/index.js"
  },
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/index.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
