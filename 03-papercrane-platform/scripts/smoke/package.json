{
  "name": "@papercrane/smoke",
  "private": true,
  "version": "0.1.0",
  "description": "End-to-end smoke test: boots apps/web and probes critical routes. Standalone (not in the pnpm workspace) so CI installs stay minimal.",
  "type": "module",
  "bin": {
    "papercrane-smoke": "./src/index.ts"
  },
  "scripts": {
    "smoke": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.15.0"
  },
  "dependencies": {
    "execa": "9.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "2.0.5"
  }
}
