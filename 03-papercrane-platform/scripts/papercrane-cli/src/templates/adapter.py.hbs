"""{{displayName}} adapter for the Paper Crane tool integration layer.

Mirrors the TypeScript `ToolAdapter` contract in
`packages/tools-sdk/src/types.ts`.

Wire format:
  IN  /inputs/request.json  (DesignRequest, schemas/input.json)
      /inputs/target.pdb
  OUT /outputs/designs/*.pdb  + *.json per-design metrics
      /outputs/result.json   (DesignResult, schemas/output.json)

Generated by `papercrane-cli scaffold-tool {{id}}` on {{generatedAt}}.
"""
from __future__ import annotations

import json
import pathlib
import subprocess
from typing import Any, Dict, List

try:
    from papercrane_sdk import (  # type: ignore[import-not-found]
        Adapter,
        Design,
        DesignConstraints,
        DesignRequest,
        DesignResult,
        Residue,
        RunMetadata,
        ToolManifest,
        ValidationError,
        run_cli,
    )
except ModuleNotFoundError:  # pragma: no cover — SDK stub for offline unit tests
    from dataclasses import dataclass, field

    @dataclass
    class Residue:  # type: ignore[no-redef]
        chain: str
        resi: int

    @dataclass
    class DesignConstraints:  # type: ignore[no-redef]
        length_range: List[int] | None = None

    @dataclass
    class DesignRequest:  # type: ignore[no-redef]
        target_pdb: str = "/inputs/target.pdb"
        target_chain: str | None = None
        hotspots: List[Residue] | None = None
        seeds: List[int] = field(default_factory=list)
        num_designs: int = 0
        constraints: DesignConstraints | None = None
        tool_params: Dict[str, Any] | None = None

        @classmethod
        def from_json(cls, payload: Dict[str, Any]) -> "DesignRequest":
            hotspots = [
                Residue(chain=h["chain"], resi=int(h["resi"]))
                for h in (payload.get("hotspots") or [])
            ]
            constraints_raw = payload.get("constraints")
            constraints = (
                DesignConstraints(length_range=list(constraints_raw.get("lengthRange", [])))
                if constraints_raw
                else None
            )
            return cls(
                target_pdb=payload.get("targetPdb", "/inputs/target.pdb"),
                target_chain=payload.get("targetChain"),
                hotspots=hotspots or None,
                seeds=list(payload.get("seeds", [])),
                num_designs=int(payload.get("numDesigns", 0)),
                constraints=constraints,
                tool_params=payload.get("toolParams") or {},
            )

    @dataclass
    class Design:  # type: ignore[no-redef]
        structurePath: str
        sequence: str
        metrics: Dict[str, float]
        seed: int

        def __getitem__(self, key: str) -> Any:
            return getattr(self, key)

    @dataclass
    class RunMetadata:  # type: ignore[no-redef]
        tool: str
        adapterVersion: str

    @dataclass
    class DesignResult:  # type: ignore[no-redef]
        designs: List[Design]
        runMetadata: RunMetadata

        @property
        def run_metadata(self) -> Dict[str, Any]:
            return {"tool": self.runMetadata.tool, "adapterVersion": self.runMetadata.adapterVersion}

    class ValidationError(dict):  # type: ignore[no-redef]
        def __init__(self, field: str, message: str) -> None:
            super().__init__(field=field, message=message)

    class ToolManifest(dict):  # type: ignore[no-redef]
        pass

    class Adapter:  # type: ignore[no-redef]
        manifest: "ToolManifest"

        def validate(self, req: DesignRequest) -> List[ValidationError]:
            return []

    def run_cli(cls: type) -> int:  # type: ignore[no-redef]
        return 0

_ = (Residue, DesignConstraints, ToolManifest)


# ------------------------- {{displayName}} adapter ------------------------- #

ADAPTER_VERSION = "a1"


class {{adapterClassName}}(Adapter):
    manifest: ToolManifest

    def validate(self, req: DesignRequest) -> List[ValidationError]:
        errors: List[ValidationError] = list(super().validate(req))
        if not req.seeds:
            errors.append(ValidationError(field="seeds", message="at least one seed required"))
        if req.num_designs <= 0:
            errors.append(ValidationError(field="numDesigns", message="must be > 0"))
        return errors

    def prepare(self, req: DesignRequest, workdir: pathlib.Path) -> Dict[str, Any]:
        workdir.mkdir(parents=True, exist_ok=True)
        cfg: Dict[str, Any] = {
            "target_pdb": "/inputs/target.pdb",
            "target_chain": req.target_chain or "A",
            "hotspots": [f"{h.chain}{h.resi}" for h in (req.hotspots or [])],
            "num_designs": req.num_designs,
            "seeds": req.seeds,
        }
        for k, v in (req.tool_params or {}).items():
            cfg.setdefault(k, v)

        cfg_path = workdir / "{{id}}.json"
        cfg_path.write_text(json.dumps(cfg, indent=2))
        return {"cfg": str(cfg_path), "out_dir": "/outputs/designs"}

    def run(self, job: Dict[str, Any]) -> Dict[str, Any]:
        out_dir = pathlib.Path(job["out_dir"])
        out_dir.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [
                "python", "/opt/{{id}}/run.py",
                "--config", job["cfg"],
                "--out", str(out_dir),
            ],
            check=True,
        )
        return {"out_dir": str(out_dir), "exit_code": 0}

    def parse(self, raw: Dict[str, Any]) -> DesignResult:
        designs: List[Design] = []
        out_dir = pathlib.Path(raw["out_dir"])
        for pdb in sorted(out_dir.glob("*.pdb")):
            meta_path = pdb.with_suffix(".json")
            if not meta_path.exists():
                continue
            meta = json.loads(meta_path.read_text())
            designs.append(
                Design(
                    structurePath=str(pdb),
                    sequence=meta["sequence"],
                    metrics={k: float(v) for k, v in meta.get("metrics", {}).items()},
                    seed=int(meta.get("seed", 0)),
                )
            )
        return DesignResult(
            designs=designs,
            runMetadata=RunMetadata(tool="{{id}}", adapterVersion=ADAPTER_VERSION),
        )


# ------------------------- Entrypoint ------------------------- #

if __name__ == "__main__":  # pragma: no cover
    raise SystemExit(run_cli({{adapterClassName}}))
