# Paper Crane Worker — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info                       # trace | debug | info | warn | error | fatal
APP_VERSION=                         # surfaced in /healthz; CI sets to git sha
SHUTDOWN_TIMEOUT_SECONDS=30

# ---- Health probe HTTP server -------------------------------------------
# The worker exposes a tiny `GET /healthz` so Fly / Docker can probe it.
PORT_HEALTH=9090

# ---- Database & Redis ---------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/papercrane
REDIS_URL=redis://localhost:6379

# ---- Concurrency (per tier) ---------------------------------------------
WORKER_CONCURRENCY_FREE=5
WORKER_CONCURRENCY_PRO=20
WORKER_CONCURRENCY_FRONTIER=50

# ---- Retention / webhooks -----------------------------------------------
DEFAULT_RETENTION_DAYS=7
RETENTION_INTERVAL_SECONDS=86400
# Active attempts heartbeat every 30s. The sweeper fences and retries jobs
# that stop heartbeating for this long.
JOB_HEARTBEAT_TIMEOUT_SECONDS=1200
STUCK_JOB_SWEEP_INTERVAL_SECONDS=60
WEBHOOK_CONCURRENCY=10
WEBHOOK_TIMEOUT_MS=10000

# ---- Observability ------------------------------------------------------
# When SENTRY_DSN is unset, Sentry is a no-op (safe for local dev).
SENTRY_DSN=
SENTRY_ENVIRONMENT=                  # defaults to NODE_ENV
SENTRY_TRACES_SAMPLE_RATE=0.1        # 0.0 .. 1.0

# ---- GPU providers (secrets) --------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WORKSPACE=
VASTAI_API_KEY=
RUNPOD_API_KEY=

# ---- Dev mode ----------------------------------------------------------
# When true (or when MODAL_TOKEN_ID is unset), the tRPC submit mutation
# synchronously marks the job succeeded and writes 5 stub Design rows
# instead of enqueueing onto BullMQ / Modal. Default: true if MODAL_TOKEN_ID
# is empty. Set to "false" to force the enqueue path even without Modal creds.
WORKER_DEV_MODE=true
