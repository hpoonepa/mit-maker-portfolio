    "@papercrane/jobs": "workspace:*",
    "@papercrane/observability": "workspace:*",
    "@papercrane/storage": "workspace:*",
    "@papercrane/tools-sdk": "workspace:*",
    "@papercrane/types": "workspace:*",
    "bullmq": "5.13.0",
    "dotenv": "16.4.5",
    "ioredis": "5.4.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@papercrane/eslint-config": "workspace:*",
    "@types/node": "22.4.1",
    "eslint": "^9.16.0",
    "tsx": "4.19.0",
    "typescript": "^5.7.2",
    "vitest": "2.0.5"
  }
