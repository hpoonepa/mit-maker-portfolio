# Paper Crane API — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info                       # trace | debug | info | warn | error | fatal
PORT=3001
HOST=0.0.0.0
APP_VERSION=                         # surfaced in /healthz; CI sets to git sha

# ---- Database & Redis ----------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/papercrane
REDIS_URL=redis://localhost:6379

# ---- Supabase auth (JWT verification) ------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- Observability -------------------------------------------------------
# When SENTRY_DSN is unset, Sentry is a no-op (safe for local dev).
# In production, missing SENTRY_DSN causes startup to fail (see config.ts).
SENTRY_DSN=
SENTRY_ENVIRONMENT=                  # defaults to NODE_ENV
SENTRY_TRACES_SAMPLE_RATE=0.1        # 0.0 .. 1.0

# ---- Security / auth -----------------------------------------------------
API_KEY_PEPPER=                      # 32+ random bytes, prod-only

# ---- CORS / app urls -----------------------------------------------------
CORS_ORIGIN=*
APP_URL=http://localhost:3000

# ---- Stripe (billing) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SEAT_ADDON=
STRIPE_PRICE_PACK_10K=

# --- Email (transactional, Wave 14) ---
# Resend API key. If unset, the email package logs to .agent-logs/email-sent.log
# instead of dispatching. Get one at https://resend.com -> API Keys.
RESEND_API_KEY=
# Verified sender. Must be on a domain whose SPF/DKIM are configured in Resend.
EMAIL_FROM_ADDRESS="Paper Crane <hello@papercrane.bio>"
