  "footnotes": [
    "Scores come from one retained Boltz-2 evaluation dated 6 July 2026. Its relationship to the original selection date is not established.",
    "ipTM, ipSAE and complex pLDDT use a 0\u20131 scale. Higher means greater predicted confidence. Interface PDE is in angstroms; lower means less predicted error.",
    "The local ipSAE implementation uses a 10 \u00c5 PAE cutoff and reports the larger of the two chain-direction scores.",
    "A dash for 5G51_V4_seed01 means the retained scored sequence has an extra starting methionine compared with the assay record.",
    "Unknown / no loading means there was no usable binding call; these six designs are not counted as negative."
  ],
  "glossary": {
    "ipTM": "Model confidence in the relative arrangement of the interacting chains.",
    "ipSAE": "An interface confidence score calculated from predicted aligned errors; this run reports the larger directional score.",
    "complex pLDDT": "Average local structural confidence across the predicted complex, including both target and binder.",
    "interface PDE": "Average predicted distance error at the interface, in \u00c5. This is a different quantity from predicted aligned error (PAE).",
    "pTM": "Predicted TM score for the whole complex; retained in sources.json but omitted from the compact display."
  },
